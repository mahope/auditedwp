{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickFormat",
  "version": "1.0.0",
  "identifier": "com.quickformat.app",
  "build": {
    "frontendDist": "../tauri-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "QuickFormat — Format Converter",
        "width": 480,
        "height": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}